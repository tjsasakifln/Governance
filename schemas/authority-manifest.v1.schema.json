{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjsasakifln/Governance/schemas/authority-manifest.v1.schema.json",
  "title": "CONFENGE commercial authority manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_id",
    "catalog_authority",
    "terms_version",
    "production_checkout_enabled",
    "production_webhook_enabled",
    "real_money_mutation_approved",
    "public_activation_approved",
    "sandbox_preparation_approved",
    "manual_preparation_approved",
    "effective_at",
    "consumers",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "authority-manifest.v1" },
    "authority_id": { "type": "string", "minLength": 1 },
    "catalog_authority": {
      "type": "string",
      "enum": ["DRAFT", "APPROVED", "ACTIVE", "PAUSED", "RETIRED"]
    },
    "terms_version": { "const": "CFG-TERMS-B2B-2026-08-17-v1" },
    "production_checkout_enabled": { "type": "boolean" },
    "production_webhook_enabled": { "type": "boolean" },
    "real_money_mutation_approved": { "type": "boolean" },
    "public_activation_approved": { "type": "boolean" },
    "sandbox_preparation_approved": { "type": "boolean" },
    "manual_preparation_approved": { "type": "boolean" },
    "effective_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_issue": { "type": "string" },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "pin": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schema_version", "content_hash", "effective_at"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "schema_version": { "type": "string", "minLength": 1 },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "effective_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    }
  }
}
