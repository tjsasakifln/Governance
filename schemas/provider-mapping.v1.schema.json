{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjsasakifln/Governance/schemas/provider-mapping.v1.schema.json",
  "title": "CONFENGE Asaas mapping table v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "provider",
    "external_reference_policy",
    "secrets_forbidden",
    "mappings"
  ],
  "properties": {
    "schema_version": { "const": "provider-mapping.v1" },
    "registry_id": { "const": "CFG-ASAAS-MAPPING-v1" },
    "provider": { "const": "asaas" },
    "authority": { "type": "string" },
    "external_reference_policy": { "const": "cfg:{offer_id}:{correlation_id}" },
    "secrets_forbidden": { "const": true },
    "mappings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/mapping_row" }
    }
  },
  "$defs": {
    "nullable_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "mapping_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offer_id",
        "asaas_product_id",
        "checkout_id",
        "subscription_mapping",
        "environment",
        "status",
        "created_at",
        "verified_at"
      ],
      "properties": {
        "offer_id": {
          "type": "string",
          "enum": [
            "CFG-DIAG-EXP-v1",
            "CFG-DIRB2G-FLEX-v1",
            "CFG-DIRB2G-180-v1",
            "CFG-DIRB2G-365-v1"
          ]
        },
        "asaas_product_id": { "$ref": "#/$defs/nullable_id" },
        "checkout_id": { "$ref": "#/$defs/nullable_id" },
        "subscription_mapping": { "$ref": "#/$defs/nullable_id" },
        "environment": { "type": "string", "enum": ["SANDBOX", "PRODUCTION"] },
        "status": {
          "type": "string",
          "enum": ["PENDING_MANUAL_CADASTRO", "MAPPED", "VERIFIED"]
        },
        "created_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "verified_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}
