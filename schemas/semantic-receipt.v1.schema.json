{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confenge.com.br/schemas/semantic-receipt.v1.schema.json",
  "title": "confenge.semantic_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "provider_event_id", "event_deduplication_id",
    "correlation_id", "raw_event_type", "canonical_state", "state_before",
    "state_after", "semantic_status", "applied", "held", "duplicate", "reason",
    "source", "freshness", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "confenge.semantic_receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "provider_event_id": {"type": "string", "minLength": 1},
    "event_deduplication_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "raw_event_type": {"type": "string", "minLength": 1},
    "canonical_state": {"enum": ["UNKNOWN", "PAYMENT_CREATED", "PAYMENT_CONFIRMED", "PAYMENT_RECEIVED", "OVERDUE", "REFUNDED", "CANCELED"]},
    "state_before": {"enum": ["UNKNOWN", "PAYMENT_CREATED", "PAYMENT_CONFIRMED", "PAYMENT_RECEIVED", "OVERDUE", "REFUNDED", "CANCELED"]},
    "state_after": {"enum": ["UNKNOWN", "PAYMENT_CREATED", "PAYMENT_CONFIRMED", "PAYMENT_RECEIVED", "OVERDUE", "REFUNDED", "CANCELED"]},
    "semantic_status": {"enum": ["APPLIED", "HELD", "RETAINED", "DUPLICATE"]},
    "applied": {"type": "boolean"},
    "held": {"type": "boolean"},
    "duplicate": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "environment", "evidence_class", "synthetic", "locator"],
      "properties": {
        "system": {"const": "asaas"}, "environment": {"const": "STUB"},
        "evidence_class": {"const": "PROVEN_SYNTHETIC"}, "synthetic": {"const": true},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "state"],
      "properties": {"observed_at": {"type": "string", "format": "date-time"}, "state": {"const": "FIXED_CLOCK"}}
    },
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
