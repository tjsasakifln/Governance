{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjsasakifln/Governance/schemas/first-commercial-window-readiness.v1.schema.json",
  "title": "First commercial window readiness projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_policy_ready",
    "control_center_readback_ready",
    "commercial_authority_observable",
    "source_health_observable",
    "reservoir_observable",
    "queue_observable",
    "transport_pause_observable",
    "kill_switch_observable",
    "mailbox_capacity_observable",
    "exceptions_operable",
    "cross_contract_version",
    "blocking_reasons",
    "decision",
    "smtp_authorized",
    "provider_dispatch_authorized",
    "first_window_go"
  ],
  "properties": {
    "schema_version": { "const": "first-commercial-window-readiness.v1" },
    "governance_policy_ready": { "type": "boolean" },
    "control_center_readback_ready": { "type": "boolean" },
    "commercial_authority_observable": { "type": "boolean" },
    "source_health_observable": { "type": "boolean" },
    "reservoir_observable": { "type": "boolean" },
    "queue_observable": { "type": "boolean" },
    "transport_pause_observable": { "type": "boolean" },
    "kill_switch_observable": { "type": "boolean" },
    "mailbox_capacity_observable": { "type": "boolean" },
    "exceptions_operable": { "type": "boolean" },
    "cross_contract_version": { "type": "string", "minLength": 1 },
    "blocking_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decision": { "enum": ["READY_FOR_FINAL_CONVERGENCE", "BLOCKED"] },
    "smtp_authorized": { "const": false },
    "provider_dispatch_authorized": { "const": false },
    "first_window_go": { "const": false }
  }
}
