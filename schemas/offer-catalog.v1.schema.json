{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjsasakifln/Governance/schemas/offer-catalog.v1.schema.json",
  "title": "CONFENGE offer catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_authority",
    "currency",
    "effective_at",
    "scope_version",
    "terms_version",
    "visibility",
    "publication_status",
    "standard_scope",
    "standard_exclusions",
    "offers"
  ],
  "properties": {
    "schema_version": { "const": "offer-catalog.v1" },
    "catalog_id": { "type": "string", "minLength": 1 },
    "catalog_authority": {
      "type": "string",
      "enum": ["DRAFT", "APPROVED", "ACTIVE", "PAUSED", "RETIRED"]
    },
    "currency": { "const": "BRL" },
    "effective_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "scope_version": { "type": "string", "minLength": 1 },
    "terms_version": { "const": "CFG-TERMS-B2B-2026-08-17-v1" },
    "visibility": {
      "type": "string",
      "enum": ["INTERNAL", "PUBLIC_CANDIDATE", "PUBLIC"]
    },
    "publication_status": {
      "type": "string",
      "enum": ["NOT_PUBLISHED", "PUBLISHED", "WITHDRAWN"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governance_issue", "delivery_parent", "consumer"],
      "properties": {
        "governance_issue": { "type": "string" },
        "delivery_parent": { "type": "string" },
        "consumer": { "type": "string" }
      }
    },
    "standard_scope": { "$ref": "#/$defs/standard_scope" },
    "standard_exclusions": { "$ref": "#/$defs/standard_exclusions" },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/offer" }
    }
  },
  "$defs": {
    "money_cents": {
      "type": "integer",
      "minimum": 0
    },
    "nullable_money_cents": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullable_positive_int": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "offer_status": {
      "type": "string",
      "enum": ["DRAFT", "APPROVED", "ACTIVE", "PAUSED", "RETIRED"]
    },
    "standard_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "applies_to",
        "contract_defense",
        "bid_room",
        "kickoff_minutes_max",
        "monthly_executive_meetings",
        "monthly_executive_meeting_minutes_max",
        "tactical_meetings_per_month_max",
        "tactical_meeting_minutes_max",
        "async_channel",
        "receipt_confirmation_business_days",
        "shared_board",
        "expansion_requires_capacity_and_addendum"
      ],
      "properties": {
        "scope_id": { "type": "string" },
        "applies_to": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contract_defense": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_public_works_or_contracts"],
          "properties": {
            "active_public_works_or_contracts": { "type": "integer", "const": 1 }
          }
        },
        "bid_room": {
          "type": "object",
          "additionalProperties": false,
          "required": ["simultaneous_wip_accepted_opportunities_max"],
          "properties": {
            "simultaneous_wip_accepted_opportunities_max": { "type": "integer", "const": 4 }
          }
        },
        "kickoff_minutes_max": { "type": "integer", "const": 90 },
        "monthly_executive_meetings": { "type": "integer", "const": 1 },
        "monthly_executive_meeting_minutes_max": { "type": "integer", "const": 90 },
        "tactical_meetings_per_month_max": { "type": "integer", "const": 2 },
        "tactical_meeting_minutes_max": { "type": "integer", "const": 30 },
        "async_channel": { "const": true },
        "receipt_confirmation_business_days": { "type": "integer", "const": 1 },
        "shared_board": { "const": true },
        "expansion_requires_capacity_and_addendum": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "standard_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unless_express_approved_addendum"],
      "properties": {
        "unless_express_approved_addendum": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "commercial_credit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_cents",
        "cumulative",
        "usable_on",
        "window_days_after_delivery"
      ],
      "properties": {
        "amount_cents": { "$ref": "#/$defs/money_cents" },
        "cumulative": { "const": false },
        "usable_on": { "const": "first_recurring_month" },
        "window_days_after_delivery": { "type": "integer", "const": 60 }
      }
    },
    "recomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_cents_per_started_month", "caps"],
      "properties": {
        "base_cents_per_started_month": { "$ref": "#/$defs/money_cents" },
        "caps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "calculated_accrued_discount",
              "20_percent_original_commitment",
              "unpaid_nominal_balance"
            ]
          }
        }
      }
    },
    "diagnostico_deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buyer_map",
        "competitors",
        "price_panel",
        "expiring_contracts",
        "screened_notices",
        "executive_recommendations_pdf",
        "spreadsheets",
        "kickoff",
        "final_presentation"
      ],
      "properties": {
        "buyer_map": { "const": true },
        "competitors": { "type": "integer", "const": 15 },
        "price_panel": { "const": true },
        "expiring_contracts": { "const": true },
        "screened_notices": { "const": true },
        "executive_recommendations_pdf": { "const": true },
        "spreadsheets": { "const": true },
        "kickoff": { "const": true },
        "final_presentation": { "const": true }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offer_id",
        "offer_code",
        "offer_version",
        "public_name",
        "internal_code",
        "description_short",
        "description_asaas",
        "status",
        "public",
        "billing_mode",
        "currency",
        "amount_cents",
        "cycle",
        "commitment_months",
        "max_payments",
        "total_commitment_cents",
        "notice_days",
        "silent_renewal",
        "consumes_recurring_slot",
        "kill_switch",
        "scope_version",
        "terms_version",
        "capacity_required",
        "capacity_units",
        "checkout_mode",
        "provider_mapping_status",
        "sold_out",
        "effective_from",
        "effective_to",
        "approval_state",
        "change_reason"
      ],
      "properties": {
        "offer_id": { "type": "string", "pattern": "^CFG-[A-Z0-9]+-[A-Z0-9]+-v[0-9]+$" },
        "offer_code": { "type": "string", "pattern": "^CFG-[A-Z0-9]+-[A-Z0-9]+-v[0-9]+$" },
        "offer_version": { "type": "string", "pattern": "^v[0-9]+$" },
        "public_name": { "type": "string", "minLength": 1 },
        "internal_code": { "type": "string", "pattern": "^CFG-[A-Z0-9]+-[A-Z0-9]+$" },
        "description_short": { "type": "string", "minLength": 1 },
        "description_asaas": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/offer_status" },
        "public": { "type": "boolean" },
        "billing_mode": { "type": "string", "enum": ["ONE_TIME", "RECURRING"] },
        "cycle": { "type": ["string", "null"], "enum": ["MONTHLY", null] },
        "currency": { "const": "BRL" },
        "amount_cents": { "$ref": "#/$defs/money_cents" },
        "commitment_months": { "$ref": "#/$defs/nullable_positive_int" },
        "max_payments": { "$ref": "#/$defs/nullable_positive_int" },
        "total_commitment_cents": { "$ref": "#/$defs/nullable_money_cents" },
        "notice_days": { "type": ["integer", "null"], "minimum": 1 },
        "silent_renewal": { "const": false },
        "recommended": { "type": "boolean" },
        "consumes_recurring_slot": { "type": "boolean" },
        "kill_switch": { "const": true },
        "scope_ref": { "type": "string" },
        "scope_version": { "type": "string", "minLength": 1 },
        "terms_version": { "const": "CFG-TERMS-B2B-2026-08-17-v1" },
        "capacity_required": { "type": "boolean" },
        "capacity_units": { "type": "integer", "minimum": 0 },
        "checkout_mode": { "type": "string", "enum": ["DETACHED", "SUBSCRIPTION"] },
        "provider_mapping_status": {
          "type": "string",
          "enum": ["PENDING", "MAPPED", "VERIFIED"]
        },
        "sold_out": { "type": "boolean" },
        "effective_from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "effective_to": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "approval_state": {
          "type": "string",
          "enum": ["DRAFT", "APPROVED", "ACTIVE", "PAUSED", "RETIRED"]
        },
        "change_reason": { "type": "string", "minLength": 1 },
        "funnel_role": { "type": "string", "enum": ["ENTRY_ONE_OFF", "RECURRING_CORE"] },
        "upsell_policy": { "const": "NEXT_ACTION_NOT_PROMISE" },
        "delivery_business_days_min": { "type": "integer", "minimum": 1 },
        "delivery_business_days_max": { "type": "integer", "minimum": 1 },
        "commercial_credit": { "$ref": "#/$defs/commercial_credit" },
        "recomposition": { "$ref": "#/$defs/recomposition" },
        "deliverables": { "$ref": "#/$defs/diagnostico_deliverables" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "billing_mode": { "const": "ONE_TIME" } },
            "required": ["billing_mode"]
          },
          "then": {
            "properties": {
              "cycle": { "type": "null" },
              "commitment_months": { "type": "null" },
              "max_payments": { "type": "null" },
              "total_commitment_cents": { "type": "null" },
              "consumes_recurring_slot": { "const": false },
              "capacity_required": { "const": false },
              "capacity_units": { "const": 0 },
              "checkout_mode": { "const": "DETACHED" }
            }
          }
        },
        {
          "if": {
            "properties": { "billing_mode": { "const": "RECURRING" } },
            "required": ["billing_mode"]
          },
          "then": {
            "required": ["cycle", "commitment_months", "max_payments", "total_commitment_cents", "notice_days"],
            "properties": {
              "cycle": { "const": "MONTHLY" },
              "consumes_recurring_slot": { "const": true },
              "capacity_required": { "const": true },
              "checkout_mode": { "const": "SUBSCRIPTION" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": { "const": "RECURRING" },
              "max_payments": { "type": "integer" }
            },
            "required": ["billing_mode", "max_payments"]
          },
          "then": {
            "required": ["total_commitment_cents", "commitment_months"]
          }
        }
      ]
    }
  }
}
