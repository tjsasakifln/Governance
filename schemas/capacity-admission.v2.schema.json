{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confenge.com.br/schemas/capacity-admission.v2.schema.json",
  "title": "confenge.capacity_admission.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "decision", "reason_codes", "blockers", "request",
    "evaluated_at", "expires_at", "evidence_class", "policy", "staffed", "wip",
    "allocations", "available_effort_units", "requested_effort", "deadline",
    "actionability", "next_action"
  ],
  "properties": {
    "schema_version": { "const": "confenge.capacity_admission.v2" },
    "decision_id": { "type": "string", "pattern": "^cadm_[0-9a-f]{32}$" },
    "decision": { "enum": ["CAN_ACCEPT", "CANNOT_ACCEPT", "UNKNOWN"] },
    "reason_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "source_ref", "next_action"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "next_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "correlation_id", "deliverable_id", "deliverable_version", "scope_version", "requested_deadline"],
      "properties": {
        "request_id": { "type": ["string", "null"] },
        "correlation_id": { "type": ["string", "null"] },
        "deliverable_id": { "type": ["string", "null"] },
        "deliverable_version": { "type": ["string", "null"] },
        "scope_version": { "type": ["string", "null"] },
        "requested_deadline": { "type": ["string", "null"], "format": "date" }
      }
    },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence_class": { "enum": ["REAL", "SYNTHETIC", "ABSENT"] },
    "policy": { "$ref": "#/$defs/policy" },
    "staffed": { "$ref": "#/$defs/staffed" },
    "wip": { "$ref": "#/$defs/wip" },
    "allocations": { "$ref": "#/$defs/allocations" },
    "available_effort_units": { "type": ["integer", "null"], "minimum": 0 },
    "requested_effort": { "$ref": "#/$defs/requestedEffort" },
    "deadline": { "$ref": "#/$defs/deadline" },
    "actionability": {
      "type": "object", "additionalProperties": false,
      "required": ["read_only", "hold_mode", "real_reservation_created", "checkout_enabled", "promise_allowed"],
      "properties": {
        "read_only": { "const": true },
        "hold_mode": { "const": "MODEL_ONLY" },
        "real_reservation_created": { "const": false },
        "checkout_enabled": { "const": false },
        "promise_allowed": { "type": "boolean" }
      }
    },
    "next_action": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "nullableNonNegative": { "type": ["integer", "null"], "minimum": 0 },
    "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "ceiling_units", "unit", "evidence_ref"],
      "properties": {
        "version": { "type": ["string", "null"] },
        "ceiling_units": { "$ref": "#/$defs/nullableNonNegative" },
        "unit": { "type": ["string", "null"], "enum": [null, "delivery_slot"] },
        "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "staffed": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "version", "capacity_units", "state", "as_of", "expires_at", "freshness", "calendar_version"],
      "properties": {
        "snapshot_id": { "type": ["string", "null"] },
        "version": { "type": ["integer", "null"], "minimum": 1 },
        "capacity_units": { "$ref": "#/$defs/nullableNonNegative" },
        "state": { "enum": ["KNOWN", "UNKNOWN"] },
        "as_of": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "calendar_version": { "type": ["string", "null"] }
      }
    },
    "wip": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "as_of", "freshness", "complete", "non_terminal_work_orders", "work_order_refs", "committed_effort_units", "blocked_effort_units"],
      "properties": {
        "snapshot_id": { "type": ["string", "null"] },
        "as_of": { "type": ["string", "null"], "format": "date-time" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "complete": { "type": "boolean" },
        "non_terminal_work_orders": { "$ref": "#/$defs/nullableNonNegative" },
        "work_order_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "committed_effort_units": { "$ref": "#/$defs/nullableNonNegative" },
        "blocked_effort_units": { "$ref": "#/$defs/nullableNonNegative" }
      }
    },
    "allocations": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "freshness", "held_effort_units", "reconciliation_required_effort_units"],
      "properties": {
        "snapshot_id": { "type": ["string", "null"] },
        "freshness": { "$ref": "#/$defs/freshness" },
        "held_effort_units": { "$ref": "#/$defs/nullableNonNegative" },
        "reconciliation_required_effort_units": { "$ref": "#/$defs/nullableNonNegative" }
      }
    },
    "requestedEffort": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "unit", "version", "readiness_state", "readiness_ref", "readiness_hash"],
      "properties": {
        "amount": { "type": ["integer", "null"], "minimum": 1 },
        "unit": { "type": ["string", "null"], "enum": [null, "delivery_slot"] },
        "version": { "type": ["string", "null"] },
        "readiness_state": { "type": ["string", "null"] },
        "readiness_ref": { "type": ["string", "null"] },
        "readiness_hash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "deadline": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "earliest_feasible", "calendar_version", "calendar_freshness", "risk"],
      "properties": {
        "requested": { "type": ["string", "null"], "format": "date" },
        "earliest_feasible": { "type": ["string", "null"], "format": "date" },
        "calendar_version": { "type": ["string", "null"] },
        "calendar_freshness": { "$ref": "#/$defs/freshness" },
        "risk": { "enum": ["FEASIBLE", "INFEASIBLE", "UNKNOWN"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "UNKNOWN" } } },
      "then": { "properties": { "actionability": { "properties": { "promise_allowed": { "const": false } } } } }
    },
    {
      "if": { "properties": { "decision": { "const": "CANNOT_ACCEPT" } } },
      "then": { "properties": { "actionability": { "properties": { "promise_allowed": { "const": false } } } } }
    },
    {
      "if": { "properties": { "evidence_class": { "enum": ["SYNTHETIC", "ABSENT"] } } },
      "then": { "properties": { "actionability": { "properties": { "promise_allowed": { "const": false } } } } }
    }
  ]
}
