{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confenge.com.br/schemas/working-calendar.v1.schema.json",
  "title": "confenge.working_calendar.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "calendar_id", "version", "synthetic", "unit", "timezone",
    "valid_from", "valid_until", "working_weekdays", "holidays", "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": "confenge.working_calendar.v1" },
    "calendar_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "unit": { "const": "business_day" },
    "timezone": { "const": "America/Sao_Paulo" },
    "valid_from": { "type": "string", "format": "date" },
    "valid_until": { "type": "string", "format": "date" },
    "working_weekdays": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 6 }
    },
    "holidays": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "format": "date" }
    },
    "evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
