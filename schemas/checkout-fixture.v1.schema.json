{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confenge.com.br/schemas/checkout-fixture.v1.schema.json",
  "title": "confenge.checkout_fixture.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "checkout_attempt_id", "correlation_id", "acceptance_id",
    "offer_id", "offer_version", "amount_cents", "external_reference", "provider",
    "environment", "mode", "provider_checkout_id", "synthetic",
    "production_checkout_enabled", "real_money_mutation_approved", "created_at",
    "source_fixture_ref", "source_fixture_hash", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "confenge.checkout_fixture.v1"},
    "checkout_attempt_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "acceptance_id": {"type": "string", "minLength": 1},
    "offer_id": {"type": "string", "minLength": 1},
    "offer_version": {"type": "string", "minLength": 1},
    "amount_cents": {"type": "integer", "minimum": 0},
    "external_reference": {"type": "string", "minLength": 1},
    "provider": {"const": "asaas"},
    "environment": {"const": "STUB"},
    "mode": {"const": "DETACHED_STUB"},
    "provider_checkout_id": {"type": "null"},
    "synthetic": {"const": true},
    "production_checkout_enabled": {"const": false},
    "real_money_mutation_approved": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "source_fixture_ref": {"type": "string", "minLength": 1},
    "source_fixture_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
