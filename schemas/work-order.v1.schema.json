{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confenge.com.br/schemas/confenge.work_order.v1.schema.json",
  "title": "confenge.work_order.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_order_id", "business_key", "synthetic", "correlation_id", "organization_id",
    "account_id", "client_ref", "opportunity_id", "qco_id", "proposal_id", "proposal_version",
    "accepted_snapshot_hash", "offer_id", "offer_version", "deliverable_id", "deliverable_version",
    "scope_version", "price_version", "terms_version", "required_inputs", "received_inputs", "created_at",
    "started_at", "due_at", "sla_business_days", "calendar_version", "clock_state", "blockers", "current_stage", "responsible_owner",
    "estimated_effort", "actual_effort", "qa_state", "qa_checklist", "artifact_refs", "delivery_state",
    "delivery_evidence_ref", "acceptance_state", "acceptance_actor", "acceptance_at", "acceptance_evidence_ref",
    "outcome", "readiness_state", "readiness_ref", "capacity_commitment_id", "onboarding_ref", "version", "last_event_id"
  ],
  "properties": {
    "schema_version": {"const": "confenge.work_order.v1"},
    "work_order_id": {"type": "string", "minLength": 1},
    "business_key": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "correlation_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "client_ref": {"type": "string", "minLength": 1},
    "opportunity_id": {"type": "string", "minLength": 1},
    "qco_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "proposal_version": {"type": "integer", "minimum": 1},
    "accepted_snapshot_hash": {"type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$"},
    "offer_id": {"type": "string", "minLength": 1},
    "offer_version": {"type": "string", "minLength": 1},
    "deliverable_id": {"type": "string", "minLength": 1},
    "deliverable_version": {"type": "string", "minLength": 1},
    "scope_version": {"type": "string", "minLength": 1},
    "price_version": {"type": "string", "minLength": 1},
    "terms_version": {"type": "string", "minLength": 1},
    "required_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "received_inputs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "sla_business_days": {"type": "integer", "minimum": 1},
    "calendar_version": {"type": "string", "minLength": 1},
    "clock_state": {"enum": ["NOT_STARTED", "RUNNING", "PAUSED", "STOPPED"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "current_stage": {"enum": ["AWAITING_INPUTS", "READY", "IN_PROGRESS", "BLOCKED", "QA", "READY_TO_DELIVER", "DELIVERED", "ACCEPTED", "CLOSED"]},
    "responsible_owner": {"type": ["string", "null"]},
    "estimated_effort": {"type": "object", "required": ["units", "unit"], "properties": {"units": {"type": "number", "exclusiveMinimum": 0}, "unit": {"type": "string"}}, "additionalProperties": false},
    "actual_effort": {"type": "object", "required": ["units", "unit"], "properties": {"units": {"type": "number", "minimum": 0}, "unit": {"type": "string"}}, "additionalProperties": false},
    "qa_state": {"enum": ["NOT_STARTED", "IN_REVIEW", "FAILED", "PASSED"]},
    "qa_checklist": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "qa_evidence_ref": {"type": "string", "minLength": 1},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "delivery_state": {"enum": ["NOT_DELIVERED", "SANDBOX"]},
    "delivery_evidence_ref": {"type": ["string", "null"]},
    "acceptance_state": {"enum": ["UNKNOWN", "ACCEPTED_SANDBOX"]},
    "acceptance_actor": {"type": ["string", "null"]},
    "acceptance_at": {"type": ["string", "null"], "format": "date-time"},
    "acceptance_evidence_ref": {"type": ["string", "null"]},
    "outcome": {"const": "UNKNOWN"},
    "closeout_evidence_ref": {"type": "string", "minLength": 1},
    "readiness_state": {"enum": ["PRODUCTION_READY", "DELIVERY_VALIDATED"]},
    "readiness_ref": {"type": "string", "minLength": 1},
    "capacity_commitment_id": {"type": "string", "minLength": 1},
    "onboarding_ref": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "last_event_id": {"type": "string", "minLength": 1}
  }
}
