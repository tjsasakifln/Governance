# Governance-owned structure for the CONFENGE public site.
# Disabled on install. Application policy is included from the web-cfg release.

upstream confenge_web_runtime {
    server 127.0.0.1:__RUNTIME_PORT__;
    keepalive 16;
}

# After certificate issuance, both HTTP names canonicalize in one hop to HTTPS apex.
server {
    listen 80;
    server_name confenge.com.br www.confenge.com.br;
    server_tokens off;

    access_log /var/log/confenge-web/http.access.log;
    error_log  /var/log/confenge-web/http.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://confenge.com.br$request_uri;
    }
}

# www never serves content and never redirects through HTTPS www.
server {
    listen 443 ssl;
    http2 on;
    server_name www.confenge.com.br;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/confenge.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/confenge.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:confenge_web_tls:10m;
    ssl_session_timeout 1d;

    include /etc/confenge/web/current/20-security-headers.conf;

    access_log /var/log/confenge-web/www.access.log;
    error_log  /var/log/confenge-web/www.error.log warn;

    return 301 https://confenge.com.br$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name confenge.com.br;
    server_tokens off;

    root /opt/confenge-web/current/_site;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/confenge.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/confenge.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:confenge_web_tls:10m;
    ssl_session_timeout 1d;

    client_max_body_size 1m;
    recursive_error_pages off;

    access_log /var/log/confenge-web/apex.access.log;
    error_log  /var/log/confenge-web/apex.error.log warn;

    # web-cfg application truth. These files move atomically with the release.
    include /etc/confenge/web/current/10-redirects.conf;
    include /etc/confenge/web/current/20-security-headers.conf;
    include /etc/confenge/web/current/30-content-types.conf;
    include /etc/confenge/web/current/40-application-locations.conf;

    # Structural custom error behavior: retain 404/410 status and use web-cfg body.
    error_page 404 /404.html;
    error_page 410 /404.html;

    location = /404.html {
        try_files /404.html =404;
        include /etc/confenge/web/current/50-static-location-policy.conf;
        include /etc/confenge/web/current/20-security-headers.conf;
    }

    # Public release provenance and ACME stay available without opening dotfiles.
    location ^~ /.well-known/ {
        try_files $uri $uri/ $uri.html =404;
        include /etc/confenge/web/current/50-static-location-policy.conf;
        include /etc/confenge/web/current/20-security-headers.conf;
    }

    # Host hardening. Generated application locations are validated not to bypass it.
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    location ~* (?:^|/)(?:secrets?|store|storage|private)(?:/|$) {
        return 404;
    }

    # Multipage static site: no catch-all rewrite and no SPA index fallback.
    location / {
        try_files $uri $uri/ $uri.html =404;
        include /etc/confenge/web/current/50-static-location-policy.conf;
        include /etc/confenge/web/current/20-security-headers.conf;
    }
}
