  "anti_noise": {
    "rule_id": "ABS_DELTA_GE_2_OR_ZERO_BREAK",
    "min_abs_delta": 2,
    "zero_is_always_material": true,
    "tie_break": "EARLIER_STAGE",
    "unknown_never_competes": true,
    "retain_previous_unless_material": true,
    "documentation": "A candidate replaces the current bottleneck only if both are OBSERVED and either the candidate count is 0 while the current is not, or current count minus candidate count is >= min_abs_delta. A +/-1 oscillation does not replace. UNKNOWN never competes as 0. Ties keep the earlier canonical stage. Previous bottleneck is retained when the new candidate is not materially lower."
  },
