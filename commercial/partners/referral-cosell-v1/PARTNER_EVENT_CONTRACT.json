    {"type": "partner_lead_accepted", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_lead_rejected", "is_received_revenue": false, "is_paid_commission": false, "opens_protection": false},
    {"type": "partner_protection_started", "is_received_revenue": false, "is_paid_commission": false, "protection_days": 90},
    {"type": "partner_protection_expired", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_opportunity_progressed", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_commission_accrual_candidate", "is_received_revenue": false, "is_paid_commission": false, "note": "Never paid revenue. Never CONFENGE received revenue."},
    {"type": "partner_commission_approved", "is_received_revenue": false, "is_paid_commission": false, "requires": ["calculation_snapshot", "approval_actor", "eligible_receipt_cents"]},
    {"type": "partner_commission_paid", "is_received_revenue": false, "is_paid_commission": true, "requires": ["receipt_evidence", "human_approval_actor", "eligible_receipt_cents"]},
    {"type": "partner_commission_adjusted", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_suspended", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_terminated", "is_received_revenue": false, "is_paid_commission": false}
