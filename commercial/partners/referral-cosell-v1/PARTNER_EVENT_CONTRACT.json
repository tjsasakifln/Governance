    "partner_version",
    "agreement_version",
    "agreement_hash",
    "lead_id",
    "opportunity_id",
    "attribution_evidence_ref",
    "source",
    "modality",
    "consent_evidence_ref",
    "protection_started_on",
    "protection_expires_on",
    "commission_policy_version",
    "eligible_receipt_cents",
