  "pii_in_aggregate_metrics": false,
  "unknown_outcome_is_not_payment": true,
  "real_money_mutation_approved": false,
  "events": [
    {"type": "partner_candidate_created", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_due_diligence_decided", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_agreement_accepted", "is_received_revenue": false, "is_paid_commission": false},
    {"type": "partner_lead_submitted", "is_received_revenue": false, "is_paid_commission": false, "requires": ["consent_evidence_ref", "source"]},
