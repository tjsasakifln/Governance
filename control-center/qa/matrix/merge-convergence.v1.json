  "title": "Merge and convergência checklist",
  "items": [
    {
      "id": "owned-path",
      "required": true,
      "text": "This campaign writes only under control-center/qa/. commercial/, decisions/, scripts/, root README, PR Governance #8, Warmbly, web-cfg, extra-cli, and other control-center/ trees stay untouched."
    },
    {
      "id": "local-adapters",
