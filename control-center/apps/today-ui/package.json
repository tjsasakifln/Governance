{
  "name": "@confenge/control-center-today-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated HOJE homepage: exception cockpit with eight ordered bands. Fixture-backed. No live HTTP, MCP, or provider mutations.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "hoje": "./src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dump": "tsx src/cli.ts dump",
    "page": "tsx src/cli.ts page",
    "generate-public": "tsx src/cli.ts generate-public"
  },
  "dependencies": {
    "@confenge/control-center-contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
