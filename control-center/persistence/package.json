{
  "name": "@confenge/control-center-persistence",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL persistence and append-only audit package for Confenge Control Center",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "sql",
    "seeds",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/migrate.test.ts tests/invariants.test.ts tests/concurrency.test.ts tests/canonical.test.ts tests/consumer.test.ts tests/durable.test.ts tests/operator-actions.test.ts",
    "migrate:up": "tsx src/cli.ts migrate:up",
    "migrate:down": "tsx src/cli.ts migrate:down",
    "seed": "tsx src/cli.ts seed"
  },
  "dependencies": {
    "@confenge/control-center-contracts": "*",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "16.14.0-beta.17",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@16.14.0-beta.17": true,
    "esbuild@0.28.2": true
  }
}
