{
  "schema_version": "control-center.production-edge.secrets-manifest.v1",
  "note": "Names and destinations only. No values. Generator writes gitignored secrets/local/ at mode 0600 and is not invoked in CI.",
  "secrets": [
    {
      "name": "POSTGRES_PASSWORD",
      "destination": "${CC_SECRET_DIR}/POSTGRES_PASSWORD",
      "injected_as": "Docker secret postgres_password; postgres POSTGRES_PASSWORD_FILE"
    },
    {
      "name": "CONTROL_CENTER_DATABASE_URL",
      "destination": "${CC_SECRET_DIR}/CONTROL_CENTER_DATABASE_URL",
      "injected_as": "env CONTROL_CENTER_DATABASE_URL for context and backup-ops"
    },
    {
      "name": "CONTROL_CENTER_BACKUP_KEY",
      "destination": "${CC_SECRET_DIR}/CONTROL_CENTER_BACKUP_KEY",
      "injected_as": "env CONTROL_CENTER_BACKUP_KEY for backup-ops"
    },
    {
      "name": "CONFENGE_MCP_AUTH_TOKEN",
      "destination": "${CC_SECRET_DIR}/CONFENGE_MCP_AUTH_TOKEN",
      "injected_as": "env CONFENGE_MCP_AUTH_TOKEN for mcp and Caddy bearer matcher"
    },
    {
      "name": "CONTROL_CENTER_FOUNDER_ACTOR_ID",
      "destination": "${CC_SECRET_DIR}/CONTROL_CENTER_FOUNDER_ACTOR_ID",
      "injected_as": "env CONTROL_CENTER_FOUNDER_ACTOR_ID for context"
    },
    {
      "name": "authelia_jwt",
      "destination": "${CC_SECRET_DIR}/authelia_jwt",
      "injected_as": "Docker secret authelia_jwt; AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE"
    },
    {
      "name": "authelia_session",
      "destination": "${CC_SECRET_DIR}/authelia_session",
      "injected_as": "Docker secret authelia_session; AUTHELIA_SESSION_SECRET_FILE"
    },
    {
      "name": "authelia_storage",
      "destination": "${CC_SECRET_DIR}/authelia_storage",
      "injected_as": "Docker secret authelia_storage; AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE"
    },
    {
      "name": "authelia_postgres_password",
      "destination": "${CC_SECRET_DIR}/authelia_postgres_password",
      "injected_as": "Docker secret authelia_postgres_password; AUTHELIA_STORAGE_POSTGRES_PASSWORD_FILE"
    },
    {
      "name": "CC_OPERATOR_PASSWORD_HASH",
      "destination": "${CC_SECRET_DIR}/CC_OPERATOR_PASSWORD_HASH",
      "injected_as": "Authelia users.yml password field (secret-produced file)"
    },
    {
      "name": "CC_OPERATOR_USER",
      "destination": "${CC_SECRET_DIR}/CC_OPERATOR_USER",
      "injected_as": "Authelia users.yml username"
    },
    {
      "name": "CC_OPERATOR_EMAIL",
      "destination": "${CC_SECRET_DIR}/CC_OPERATOR_EMAIL",
      "injected_as": "Authelia users.yml email"
    },
    {
      "name": "CC_PUBLIC_DOMAIN",
      "destination": "${CC_SECRET_DIR}/CC_PUBLIC_DOMAIN",
      "injected_as": "pinned ops.confenge.com.br"
    },
    {
      "name": "CC_AUTH_DOMAIN",
      "destination": "${CC_SECRET_DIR}/CC_AUTH_DOMAIN",
      "injected_as": "pinned auth.ops.confenge.com.br"
    },
    {
      "name": "CC_COOKIE_DOMAIN",
      "destination": "${CC_SECRET_DIR}/CC_COOKIE_DOMAIN",
      "injected_as": "pinned ops.confenge.com.br"
    },
    {
      "name": "CC_TRUSTED_PROXY_CIDRS",
      "destination": "${CC_SECRET_DIR}/CC_TRUSTED_PROXY_CIDRS",
      "injected_as": "env CC_TRUSTED_PROXY_CIDRS (immediate hop; never X-Forwarded-For)"
    }
  ]
}
