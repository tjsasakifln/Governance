{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-center.pncp.service-health/1.0",
  "title": "ServiceHealth",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "observed_at",
    "freshness_status",
    "confidence",
    "service",
    "healthy",
    "label",
    "reasons",
    "evidence",
    "collector_alive",
    "collector_stalled"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "control-center.pncp.freshness/1.0" },
    "source": { "const": "pncp" },
    "observed_at": { "type": "string", "format": "date-time" },
    "freshness_status": {
      "enum": ["FRESH", "STALE", "ERROR", "UNKNOWN"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "service": { "const": "pncp" },
    "healthy": { "type": "boolean" },
    "label": { "type": "string" },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": { "$ref": "./freshness-evidence.schema.json" },
    "collector_alive": { "type": "boolean" },
    "collector_stalled": { "type": "boolean" }
  }
}
