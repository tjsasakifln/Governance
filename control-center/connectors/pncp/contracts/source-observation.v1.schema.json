{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-center.pncp.source-observation.v1",
  "title": "SourceObservation v1 (PNCP adapter emission)",
  "description": "Canonical Control Center SourceObservation. extra-cli evidence lives in payload. ERROR requires error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "scope",
    "provenance",
    "collected_at",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "control-center.source-observation.v1" },
    "id": { "const": "cc:source-observation:pncp-contracts" },
    "scope": { "const": "infrastructure" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at", "freshness_status", "confidence"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "kind", "locator"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "locator": { "type": "string", "minLength": 1 },
            "label": { "type": "string" }
          }
        },
        "observed_at": { "type": "string", "minLength": 20 },
        "freshness_status": {
          "enum": ["FRESH", "STALE", "UNKNOWN", "ERROR"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness_window_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "collected_at": { "type": "string", "minLength": 20 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "payload_schema_ref": { "const": "PNCP_CONTRACT_FRESHNESS/1.0" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
