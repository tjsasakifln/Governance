{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-center.pncp.source-observation/1.0",
  "title": "SourceObservation",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "observed_at",
    "freshness_status",
    "confidence",
    "last_item_observed_at",
    "last_success_at",
    "lag_seconds",
    "recent_window_count",
    "consecutive_errors",
    "source_max_timestamp",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "control-center.pncp.freshness/1.0" },
    "source": { "const": "pncp" },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "freshness_status": {
      "enum": ["FRESH", "STALE", "ERROR", "UNKNOWN"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "last_item_observed_at": { "type": ["string", "null"], "format": "date-time" },
    "last_success_at": { "type": ["string", "null"], "format": "date-time" },
    "lag_seconds": { "type": ["integer", "null"] },
    "recent_window_count": { "type": ["integer", "null"] },
    "consecutive_errors": { "type": ["integer", "null"] },
    "source_max_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "evidence": { "$ref": "./freshness-evidence.schema.json" }
  }
}
