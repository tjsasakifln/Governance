{
  "name": "@confenge/control-center-asaas",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Asaas finance connector for Confenge Control Center. GET-only. Never mutates Asaas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "consumer": "tsx scripts/consumer.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
