{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tjsasakifln/Governance/control-center/contracts/schemas/work-order-event.v1.schema.json",
  "title": "CONFENGE Work Order Event v1",
  "description": "Versioned append-only event. Out-of-order and conflicting events are retained as holds by persistence and never inferred into order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_version", "work_order_id", "expected_version", "event_type",
    "actor", "reason_code", "literal_reason_ref", "occurred_at", "idempotency_key", "correlation_id",
    "causation_id", "source_system", "evidence_refs", "transition", "data"
  ],
  "properties": {
    "schema_version": { "const": "confenge.work_order_event.v1" },
    "event_id": { "type": "string", "pattern": "^cc:work-order-event:[A-Za-z0-9._~-]+$" },
    "event_version": { "type": "integer", "minimum": 1 },
    "work_order_id": { "type": "string", "pattern": "^cc:work-order:[A-Za-z0-9._~-]+$" },
    "expected_version": { "type": "integer", "minimum": 0 },
    "event_type": { "enum": [
      "WORK_ORDER_CREATED", "INPUT_RECEIVED", "INPUT_WAIVED", "OWNER_ASSIGNED", "PRODUCTION_STARTED",
      "WORK_BLOCKED", "WORK_RESUMED", "EFFORT_RECORDED", "QA_SUBMITTED", "QA_PASSED", "QA_FAILED",
      "DELIVERY_RECORDED", "CLIENT_ACCEPTED", "CLIENT_REWORK_REQUESTED", "REWORK_STARTED",
      "NONCONFORMITY_OPENED", "NONCONFORMITY_RESOLVED", "CHANGE_REQUEST_OPENED",
      "CHANGE_REQUEST_ACCEPTED", "CHANGE_REQUEST_REJECTED", "CLOCK_PAUSED_CLIENT",
      "CLOCK_PAUSED_INTERNAL", "CLOCK_PAUSED_FORCE_MAJEURE", "CLOCK_RESUMED",
      "WORK_ORDER_CANCELLED", "WORK_ORDER_CLOSED"
    ] },
    "actor": { "$ref": "https://github.com/tjsasakifln/Governance/control-center/contracts/schemas/primitives.v1.schema.json#/$defs/actor_ref" },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
    "literal_reason_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/#~-]{0,511}$" },
    "occurred_at": { "$ref": "https://github.com/tjsasakifln/Governance/control-center/contracts/schemas/primitives.v1.schema.json#/$defs/utc_datetime" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 512 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causation_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "source_system": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/#~-]{0,511}$" } },
    "transition": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["from_stage", "to_stage"],
          "properties": {
            "from_stage": { "$ref": "https://github.com/tjsasakifln/Governance/control-center/contracts/schemas/work-order.v1.schema.json#/$defs/stage" },
            "to_stage": { "$ref": "https://github.com/tjsasakifln/Governance/control-center/contracts/schemas/work-order.v1.schema.json#/$defs/stage" }
          }
        }
      ]
    },
    "data": { "type": "object" }
  }
}
