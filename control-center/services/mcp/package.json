{
  "name": "@confenge/control-center-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Confenge Control Center MCP server: scoped agent context and session reports.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "confenge-mcp": "./dist/index.js"
  },
  "scripts": {
