{
  "name": "@confenge/control-center-finance",
  "version": "0.1.0",
  "private": true,
  "description": "Executive finance read-model for Confenge Control Center. Distinguishes contracted, invoiced, paid, received, overdue, and receivable. Never treats contract or billing as caixa. Read-only; no provider mutations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "cc-finance": "./src/cli.ts"
  },
  "files": [
    "src",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "consumer": "tsx scripts/consumer.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@confenge/control-center-contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
