# In-process store is the persistence bar for this wave. No secrets required.
CONTROL_CENTER_AGENT_ACTIVITY_STORE=memory

# Idle threshold for stale RUNNING sessions. After this many seconds without a
# heartbeat (or started_at if none), RUNNING is reconciled to UNKNOWN with
# needs_reconciliation. Never auto-DONE. Default: 7200 (2 hours).
AGENT_ACTIVITY_IDLE_THRESHOLD_SECONDS=7200

# Display timezone for operator presentation only. Internal timestamps stay UTC.
CONTROL_CENTER_DISPLAY_TZ=America/Sao_Paulo

# Optional structured JSON logs to stderr (1/true). Never enable dumping payloads.
AGENT_ACTIVITY_LOG=0

# Reserved for convergence with control-center/persistence.
# This package will not open a database connection in this wave.
# Never commit the value. Never put the URL in logs, git, or client bundles.
# DATABASE_URL=
